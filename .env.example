# PostgreSQL service credentials (used by both postgres container and backend app)
POSTGRES_USER=chatuser
POSTGRES_PASSWORD=chatpass
POSTGRES_DB=chatdb

# Backend app DB connection (DB_HOST uses docker service name)
DB_USER=chatuser
DB_PASSWORD=chatpass
DB_HOST=postgres
DB_PORT=5432
DB_NAME=chatdb

# Backend app Redis connection (uses docker service name)
REDIS_URL=redis://redis:6379

# Other backend settings
CORS_ORIGINS=*
REDIS_CHANNEL=chat:channel
REDIS_ONLINE_USERS_KEY=chat:online_users
MESSAGE_HISTORY_LIMIT=50
