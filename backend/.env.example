DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatdb
REDIS_URL=redis://localhost:6379
# 여러 origin은 쉼표로 구분 (예: http://localhost:3000,https://example.com)
CORS_ORIGINS=*
REDIS_CHANNEL=chat:channel
REDIS_ONLINE_USERS_KEY=chat:online_users
MESSAGE_HISTORY_LIMIT=50
